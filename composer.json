{
    "name": "iammuttaqi/filament-fakester",
    "description": "A Filament plugin to generate fake data for your Laravel application.",
    "keywords": [
        "iammuttaqi",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-fakester"
    ],
    "homepage": "https://github.com/iammuttaqi/filament-fakester",
    "support": {
        "issues": "https://github.com/iammuttaqi/filament-fakester/issues",
        "source": "https://github.com/iammuttaqi/filament-fakester"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Muttaqi",
            "email": "muntasermuttaqi@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.6.5",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.6",
        "laravel/pint": "^1.29.1",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^9.0|^10.0|^11.1",
        "pestphp/pest": "^3.7|^4.7",
        "pestphp/pest-plugin-arch": "^3.0|^4.0.2",
        "pestphp/pest-plugin-laravel": "^3.0|^4.1",
        "pestphp/pest-plugin-livewire": "^3.0|^4.1",
        "rector/rector": "^2.4.4",
        "spatie/laravel-ray": "^1.43.9"
    },
    "autoload": {
        "psr-4": {
            "Iammuttaqi\\FilamentFakester\\": "src/",
            "Iammuttaqi\\FilamentFakester\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Iammuttaqi\\FilamentFakester\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Iammuttaqi\\FilamentFakester\\FilamentFakesterServiceProvider"
            ],
            "aliases": {
                "FilamentFakester": "Iammuttaqi\\FilamentFakester\\Facades\\FilamentFakester"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
